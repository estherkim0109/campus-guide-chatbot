{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListDocsBucket",
            "Effect": "Allow",
            "Action": "s3:ListBucket",
            "Resource": "arn:aws:s3:::campus-guide-docs-esther"
        },
        {
            "Sid": "ReadDocs",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::campus-guide-docs-esther/*"
        }
    ]
}
